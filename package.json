{
  "name": "musicbotdiscord",
  "version": "0.1.0",
  "private": true,
  "description": "Discord music bot MVP with YouTube, yt-dlp, FFmpeg and @discordjs/voice",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.27.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.1"
  }
}
