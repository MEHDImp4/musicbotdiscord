{
  "name": "pulse",
  "version": "0.1.1",
  "private": true,
  "description": "Discord music bot MVP with YouTube, yt-dlp, FFmpeg and @discordjs/voice",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "deploy:commands": "tsx --env-file=.env src/deploy-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "dependencies": {
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "1.0.0-dev.1789257813-c626815bf",
    "discord.js": "14.27.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.1"
  }
}
